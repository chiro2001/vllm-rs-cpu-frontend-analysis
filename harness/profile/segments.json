{
  "_doc": [
    "火焰图帧 → P1..P10 分段映射规则（docs/01-request-path.md §1 的分段定义）。",
    "规则按顺序匹配，先命中先用。match 是 Python re.search 的正则，作用于帧名（叶子帧或任意帧）。",
    "basis 列写清归属依据：symbol=符号语义直接可判；code=源码/依赖已核实；heuristic=按名字形状推断。",
    "跨段桶（X-*）是**无法归到单一 P 段**的成本：分配器、通用内存拷贝、异步运行时分发。",
    "它们不撒谎地把「不落在任何一段」的成本单独列出来，而不是摊到某一段里。"
  ],
  "rules": [
    {"segment": "X-py-interp", "match": "_PyEval_EvalFrameDefault|_PyObject_Malloc|_PyObject_Free|_PyType_Lookup|_PyFunction_Vectorcall|_Py_dict_lookup|_PyObject_GenericGetAttrWithDict|unicodekeys_lookup_unicode|initialize_locals|_PyLong_|_PyUnicode_|_PyDict_|_PyTuple_|_PyList_|_PyMem_|Py_INCREF|Py_DECREF|_PyEval_", "basis": "symbol", "note": "**CPython 解释器本体**：逐条派发 + 对象内务。它不对应 P1–P10 的任何一段，而是 Python 前端特有的、被 Rust 换掉的那一层 ⇒ 单列（REMOTE_HOST A4 对照用）"},
    {"segment": "X-py-interp", "match": "^_?Py(Incref|Decref|Object_|Dict_|List_|Tuple_|Unicode_|Long_|Float_|Mem_|GC_|Frame_|Eval_|Malloc|Type_|Set_|String)|^tupledealloc|^dict_dealloc|^frame_dealloc|^recursive_dealloc|^module_dealloc|^subtype_dealloc|^slot_tp_|^lookdict|^unicodekeys|^pymalloc|^_PyMalloc|^_PyArena|^gc_|^_PyGC_|^gen_|^method_|^object_dealloc|^object_init|^type_get|^PyEval_", "basis": "symbol", "note": "**CPython 解释器/对象内务（扩展匹配）**：与上一条同桶；CPython 的符号命名很杂，这里覆盖 Py* / _Py* / *dealloc / lookdict 等家族"},
    {"segment": "X-py-venv", "match": "uvloop|asyncio|libuv|__Pyx_|cython", "basis": "symbol", "note": "Python 侧事件循环（uvloop/asyncio），对应 Rust 的 tokio runtime（X-runtime）"},
    {"segment": "P4", "match": "tokenizers::", "basis": "symbol", "note": "Python 侧 HF tokenizers（Rust 侧是 fastokens）"},
    {"segment": "P2", "match": "pydantic_core|_pydantic_core", "basis": "symbol", "note": "Python 侧请求体校验（对应 Rust 的 validator/serde）"},
    {"segment": "P7", "match": "libzmq|_zmq\\.abi3|zmq/backend|zmq\\.libs", "basis": "symbol", "note": "Python 侧的 ZMQ（南北向边界，P6/P7 共用；符号名分不出方向 ⇒ 归到 P7 并在文档标注）"},
    {"segment": "P4", "match": "^(pcre2|fastokens)", "basis": "code", "note": "Cargo.lock 反查：只有 fastokens 依赖 pcre2；fastokens 是分词 pre-tokenizer ⇒ P4"},
    {"segment": "P4", "match": "^pcre2_(jit_)?match_8$", "basis": "code", "note": "PCRE2 匹配入口（fastokens 预分词正则）"},
    {"segment": "P4", "match": "jit_machine_stack|jit_machine_stack_desc", "basis": "code", "note": "PCRE2 JIT 的机器栈（fastokens 正则）"},
    {"segment": "P4", "match": "^\\[perf-\\d+\\.map\\]_\\[j\\]$", "basis": "code", "note": "进程里唯一的 rwx 匿名映射（64 KiB）= PCRE2 JIT 代码区；fastokens 是唯一 pcre2 使用者"},
    {"segment": "P4", "match": "icu_normalizer", "basis": "code", "note": "fastokens 的 unicode 归一化（tokenizer 预处理）"},
    {"segment": "P4", "match": "vllm_tokenizer::hf|vllm_tokenizer::lib\\b|Tokenizer::encode|tokenizers::tokenizer::Tokenizer", "basis": "symbol", "note": "分词 encode"},
    {"segment": "P9", "match": "vllm_parser::|vllm_chat::output|UnifiedParser|ReasoningParser|ToolParser|ChatOutputProcessor|structured::|delimited", "basis": "symbol", "note": "parser"},
    {"segment": "P3", "match": "minijinja::|vllm_chat::renderer|TemplateMessage|TemplateTool|tojson", "basis": "symbol", "note": "chat 模板渲染"},
    {"segment": "P8", "match": "vllm_tokenizer::incremental|DecodeStream|byte_level_decode|next_chunk|seed_prefix", "basis": "symbol", "note": "增量解码"},
    {"segment": "P8", "match": "vllm_text::output::decoded", "basis": "symbol", "note": "增量解码编排"},
    {"segment": "P5", "match": "vllm_text::lower|lower_text_request|lower_sampling_params|validate_prompt_token_ids|chat_completions::convert", "basis": "symbol", "note": "lower / 校验"},
    {"segment": "P6", "match": "rmp::encode|rmp_serde::encode|to_vec_named|send_to_engine|RouterSendHalf|zeromq::router|encode_msgpack|ZmqMessage", "basis": "symbol", "note": "msgpack 序列化 + ZMQ 下发"},
    {"segment": "P7", "match": "rmp_serde::decode|rmp::decode|decode_msgpack|decode_engine_core_outputs|EngineCoreOutputs|run_output_loop|run_output_dispatcher_loop|RequestRegistry|EngineCoreOutputStream|client::stream|WireEngineCoreOutputs|pull::PullSocket|ZmqCodec|asynchronous_codec::framed_read", "basis": "symbol", "note": "msgpack 反序列化 + 分流 + ZMQ 收包"},
    {"segment": "P2", "match": "serde_json::de|serde_json::Deserializer|serde_path_to_error|chat_completions::types|validate::|ValidationError|Normalizable", "basis": "symbol", "note": "请求体 JSON 反序列化（serde_json 专属帧 + axum 的 serde_path_to_error + validator）"},
    {"segment": "P2", "match": "serde_json::read::|serde_json::error::|SliceRead", "basis": "symbol", "note": "JSON 读取层"},
    {"segment": "P10", "match": "serde_json::ser|serde_json::to_string|SerializeMap|chat_completion_chunk_stream|chat_completion_sse_stream|Sse|collect_chat_completion|ChatCompletion(Stream)?Response|ChatCompletionChunk|ChatMessageDelta|types::_::<impl serde_core::ser::Serialize|to_value|event::Event|itoa::", "basis": "symbol", "note": "响应 JSON 序列化 + SSE 回写（itoa = 数字格式化）"},
    {"segment": "P1", "match": "axum::|hyper::|tower::|tower_http|httparse|server::middleware|server::routes::|server::listener|http::header|http::extensions|http_body|CorsLayer|Route", "basis": "symbol", "note": "HTTP 接入与 middleware"},
    {"segment": "P1", "match": "^vllm_server::routes::|matchit::|Route|MethodRouter", "basis": "symbol", "note": "路由/handler 骨架（P1 的 middleware 与路由解析）"},
    {"segment": "X-serde", "match": "serde_core::de|serde::de::|<&mut A as serde_core::de|serde_core::ser|serde::ser::|try_from_value|from_value", "basis": "heuristic", "note": "serde 的**泛型适配层**：同一批符号同时服务 P2（JSON）与 P6/P7（msgpack），符号名分不出方向 ⇒ 单列（逐帧斜率见 slope-model.csv）"},
    {"segment": "P3", "match": "indexmap::", "basis": "heuristic", "note": "minijinja Value 的 TemplateMap=IndexMap；但也可能来自其它 map ⇒ 推断"},

    {"segment": "X-alloc", "match": "^_?mi_|mimalloc|^malloc$|^free$|^calloc$|^realloc$|RawVec|alloc::alloc|handle_error|Box<|Arc<T,A>::drop_slow|drop_in_place", "basis": "heuristic", "note": "全局分配器（mimalloc）——服务 P1..P10 全部，栈上无法区分调用方"},
    {"segment": "X-copy", "match": "memcpy|memmove|memset|^\\[libc\\.so\\.6\\]$|libc.so.6|bcmp|memcmp", "basis": "code", "note": "通用块拷贝：glibc AVX-512 实现（反汇编坐实，见 docs/02 §5）；调用方未知 ⇒ 跨段"},
    {"segment": "X-hash", "match": "hashbrown::|ahash|hash_one|BuildHasher|sip::Hasher|HashMap<K,V,S,A>|DefaultHasher", "basis": "heuristic", "note": "哈希表（请求注册表 / 去重 / 指标 label），跨段"},
    {"segment": "X-runtime", "match": "tokio::|futures_util|futures_core|asynchronous_codec|Harness<|Context::run|Context::run_task|mpsc|oneshot|poll_next|AsynkStrim|asynk_strim|Notify|Waker|parking_lot|WakerRef", "basis": "heuristic", "note": "tokio/futures 任务调度、channel、锁，跨段"},
    {"segment": "X-tls", "match": "std::thread::local::LocalKey|__tls_get_addr", "basis": "code", "note": "TLS 包装：二进制里 58 个同名实例；热点实例（0xaa3630）体内联 Vec 增长、无 TLS 指令 ⇒ 名字误导，仍无法定段"},
    {"segment": "X-log", "match": "tracing|sharded_slab|tracing_subscriber|log::|RUST_LOG", "basis": "heuristic", "note": "日志/追踪（tracing 子系统），跨段"},
    {"segment": "X-metrics", "match": "prometheus|vllm_llm::request_metrics|request_metrics|Timespec|Instant|SystemTime|clock_gettime", "basis": "heuristic", "note": "指标与计时，跨段"},
    {"segment": "X-bytes", "match": "^bytes::|BytesMut|Bytes::", "basis": "heuristic", "note": "byte buffer（hyper body / codec），跨段"},
    {"segment": "X-park", "match": "crossbeam_deque|rayon_core|WorkerThread|Stealer|__sched_yield|Condvar|Parker::park|Unparker", "basis": "heuristic", "note": "线程池等待/自旋（rayon 由 fastokens 拉起）与调度让出"},
    {"segment": "X-str", "match": "core::str::converts::from_utf8|char::|utf8|Chars|TwoWaySearcher|StrSearcher|String>::from_utf8_lossy|memchr", "basis": "heuristic", "note": "UTF-8/子串搜索：既可能是模板、也可能是 stop-string 判定 ⇒ 跨段"},
    {"segment": "X-kernel", "match": "_\\[k\\]$|\\[\\[vdso\\]\\]|vdso|syscall|getrandom|epoll|futex", "basis": "code", "note": "内核/vDSO：syscall、时钟"},
    {"segment": "X-unknown", "match": "^\\[unknown\\]$|^0x|^\\[vllm-rs\\]$|^<unknown>|^pow$|^\\[libm|\\[libm\\.so\\.6\\]", "basis": "heuristic", "note": "未解析帧（libm 等）"},
    {"segment": "X-rust", "match": "core::|alloc::|std::|hashbrown", "basis": "heuristic", "note": "其余 Rust 标准库/核心泛型代码：落到这里说明没有更强的语义归属"}
  ]
}
